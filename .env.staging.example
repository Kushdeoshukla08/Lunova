# ═══════════════════════════════════════════════════════════════════════════════
#  Lunova — STAGING
#  Set these in the staging host's env / secret manager. NEVER reuse a
#  production or a local value here, and never copy a staging value into prod.
#  Provisioning steps (free path: Render + Neon): docs/STAGING-RUNBOOK.md
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production                       # staging runs a production build
APP_ENV=staging                           # ← drives secure cookies, HSTS, log level, seed guard
APP_URL=https://lunova-staging.onrender.com   # the real staging origin (edit to the assigned host)

# openssl rand -base64 48   — unique to staging, never shared with prod
AUTH_SECRET=

# ── Database — a SEPARATE Postgres from production (Neon free tier) ──────────
DATABASE_URL=postgresql://USER:PASS@HOST-pooler/neondb?sslmode=require

# Migrations are applied on container boot by default — the free tier has no
# release hook or Shell, so the container is the only place they can run. Set
# MIGRATE_ON_START=0 only where something else owns them (docker-compose does).
# MIGRATE_ON_START=0

SESSION_TTL_DAYS=30

# ── Redis — not needed for single-instance staging; leave unset ─────────────
# REDIS_URL=rediss://default:TOKEN@HOST:6379

# ── Providers — free path uses the built-in console/local defaults ──────────
# Everything is behind an abstraction (docs/PROVIDERS.md); switch any of these
# to a real vendor later by setting its vars — no code change.

# Email: console = the facilitator reads the 6-digit code from the Render logs
# during a moderated session. Switch to resend + a sending subdomain for
# unattended signups.
EMAIL_PROVIDER=console
EMAIL_FROM="Lunova (staging) <hello@staging.lunova.app>"
# RESEND_API_KEY=

# SMS: console. Phone verification is optional and testers skip it.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Storage: local = the container's ephemeral disk. Uploads vanish on redeploy;
# staging media is disposable and the seed regenerates persona photos. Switch to
# s3/R2 for persistence.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.uploads
# S3_BUCKET=lunova-staging-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://ACCOUNTID.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://staging-media.lunova.app

# Moderation: heuristic (no vendor). Fails open for text / safe for images.
MODERATION_PROVIDER=heuristic
# MODERATION_API_KEY=

# Music: internal identity signal. A SEPARATE Spotify app (staging redirect URI)
# only if/when you wire OAuth.
MUSIC_PROVIDER=internal
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://lunova-staging.onrender.com/api/music/spotify/callback

# Identity verification: leave unset for staging.
# IDV_PROVIDER=
# IDV_API_KEY=

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info
METRICS_TOKEN=                            # required to expose GET /api/metrics
# SENTRY_DSN=                             # a staging project, separate from prod
# BUILD_COMMIT=                           # optional; /api/health also reads
#                                         # RENDER_GIT_COMMIT (Render sets it) etc.

# ── Staging seed (run from your laptop against the staging DB, not here) ────
#   export DATABASE_URL='…neon pooled url…'
#   npx prisma migrate deploy && npm run db:seed
#   APP_ENV=staging SEED_STAGING=1 npm run db:seed:staging
# SEED_STAGING is a flag for that command only — not a running-app env var.
# Never set in production.
