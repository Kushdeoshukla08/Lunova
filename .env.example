# ═══════════════════════════════════════════════════════════════════════════════
#  Lunova environment
#  Copy to `.env` for local dev. NEVER commit a real `.env*` (only this file).
#  In production, set these in your platform's secret manager. See docs/DEPLOYMENT.md.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                      # development | test | production
APP_URL=http://localhost:3000             # public origin; used for links & OG images

# 32+ chars. Reserved for signing (email links, future CSRF). Set a strong,
# unique value per environment.  openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string

# ── Database (PostgreSQL) — read by Prisma via prisma.config.ts ──────────────
DATABASE_URL=postgresql://lunova_app:password@127.0.0.1:5433/lunova_dev?schema=public
# Only for `prisma migrate dev` locally (auto-managed if you have CREATEDB):
# SHADOW_DATABASE_URL=postgresql://lunova_app:password@127.0.0.1:5433/lunova_shadow?schema=public

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30

# ── Realtime + rate limiting ────────────────────────────────────────────────
# Unset  → in-process realtime fan-out + in-memory rate limiter (single instance).
# Set    → (once the Redis adapters are added) pub/sub + distributed limits.
# REDIS_URL=rediss://default:token@host:6379

# ── Providers ───────────────────────────────────────────────────────────────
# Each has a local/dev default; set the vars below to switch to a real vendor.

# Music (identity signal only — not a full library)
MUSIC_PROVIDER=internal                   # internal | spotify
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=${APP_URL}/api/music/spotify/callback

# Email (verification, security notices, account events)
EMAIL_PROVIDER=console                    # console | resend | ses | postmark
EMAIL_FROM="Lunova <hello@lunova.app>"
# RESEND_API_KEY=
# AWS_SES_REGION=

# SMS (phone verification only)
SMS_PROVIDER=console                      # console | twilio | messagebird
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+10000000000

# Object storage for media
STORAGE_PROVIDER=local                    # local | s3
STORAGE_LOCAL_DIR=.uploads               # local provider only
# S3_BUCKET=lunova-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # R2/MinIO; omit for AWS S3
# S3_PUBLIC_URL=https://media.lunova.app                     # CDN base for signed reads

# Content moderation (text + image)
MODERATION_PROVIDER=heuristic             # heuristic | hive | openai | rekognition
# MODERATION_API_KEY=

# Identity verification (returns a result — Lunova never stores documents)
# IDV_PROVIDER=persona                    # persona | veriff | stripe-identity
# IDV_API_KEY=
# IDV_WEBHOOK_SECRET=

# ── Observability (optional) ────────────────────────────────────────────────
# LOG_LEVEL=info                 # debug | info | warn | error  (default: info in prod)
# METRICS_TOKEN=                 # unset ⇒ GET /api/metrics is disabled (404)
# SENTRY_DSN=                    # unset ⇒ errors are logged only
# OTEL_EXPORTER_OTLP_ENDPOINT=
