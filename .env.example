# ─── Lunova environment ───────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ byte random string — used to sign session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string

# Database (PostgreSQL). Prisma reads this via prisma.config.ts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunova_dev?schema=public
# Optional: separate shadow DB for `prisma migrate dev` (auto-managed if omitted and you have CREATEDB).
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunova_shadow?schema=public

# Sessions
SESSION_TTL_DAYS=30

# Rate limiting / queues. Leave REDIS_URL unset to use the in-memory adapter (dev only).
# REDIS_URL=redis://localhost:6379

# Provider abstractions — all default to local/mock implementations when unset.
# MUSIC_PROVIDER=internal            # internal | spotify
# MODERATION_PROVIDER=heuristic      # heuristic | <vendor>
# SMS_PROVIDER=console               # console | <vendor>
# EMAIL_PROVIDER=console             # console | <vendor>
# STORAGE_PROVIDER=local             # local | s3
# STORAGE_LOCAL_DIR=.uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Optional identity-verification vendor (we store references, never documents).
# IDV_PROVIDER=
# IDV_API_KEY=
